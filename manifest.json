{
  "manifest_version": 3,
  "name": "Domein Research",
  "version": "0.1.0",
  "description": "Scoped subdomain, endpoint, and exposure research for authorized assessments.",
  "permissions": ["storage", "downloads", "activeTab", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Open Domein Research",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" }
}
